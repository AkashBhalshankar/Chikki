# Rename this file to .env and fill in your real values. Never commit .env.

# --- LLM providers (tried in this order; configure at least one) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
NVIDIA_API_KEY=
# Models retire without warning; the daily health check alerts you when one does.
# Fast, non-reasoning models that worked on 2026-11-27: poolside/laguna-xs-2.1, nvidia/nemotron-3.5-bolt-e4b
NVIDIA_MODEL=poolside/laguna-xs-2.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# --- Resume source ---
GOOGLE_DRIVE_RESUME_URL=

# --- Knowledge base (RAG) ---
# Markdown files in backend/knowledge/ are indexed automatically.
# Optional extra sources: comma-separated raw text/Markdown URLs (implemented projects only).
KNOWLEDGE_URLS=
# NVIDIA embedding model for hybrid retrieval (keyword search is used when empty or unavailable).
# Verified working on 2026-11-26 (older nemotron-3-embed-1b, embed-qa-4 and nv-embedqa models are retired):
#   nvidia/nemotron-3.5-embed-1b  - recommended: fast, 2048 dimensions   https://build.nvidia.com/nvidia/nemotron-3.5-embed-1b
#   nvidia/nemotron-3.5-embed-8b  - higher quality, slower, 4096 dims    https://build.nvidia.com/nvidia/nemotron-3.5-embed-8b
# Model catalog: https://build.nvidia.com/models   (list what your key can use: GET https://integrate.api.nvidia.com/v1/models)
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
RAG_TOP_K=3

# --- Recruiter-facing extras ---
# Your GitHub username: lets Chikki mention your latest public repos when asked.
GITHUB_USERNAME=

# --- Notifications (visitor messages, weekly digest, health alerts) ---
# Use any combination. Check delivery with: POST /notify/test (admin token required).
# Telegram (instant): create a bot with @BotFather, send it a message, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Resend (https://resend.com). Replying to the email goes straight to the visitor.
RESEND_API_KEY=
# Where emails are sent (comma separated). With Resend and no verified domain, this must be your
# Resend account address, otherwise Resend refuses (SMTP below then delivers instead).
CONTACT_TO=
# After verifying a domain at resend.com/domains, send from it and to any address:
# CONTACT_FROM=Chikki <chikki@yourdomain.com>
CONTACT_FROM=
# Email via SMTP, e.g. Gmail with an App Password (Google Account > Security > 2-Step Verification >
# App passwords). Used as a fallback after Resend, and good for local use. Note: Render's free tier
# blocks outbound SMTP, so on Render use Resend with a verified domain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
# SMTP_FROM=Chikki <you@gmail.com>
# Optional Slack/Discord-style webhook
CONTACT_WEBHOOK_URL=
# Live Telegram feed of visitor conversations (the full question and a one-line answer).
# Leave off locally so your own testing does not ping you; turn on in production.
NOTIFY_CONVERSATIONS=false
NOTIFY_CONVERSATIONS_PER_HOUR=60
# Where each kind of notification goes. Defaults (one channel each, no duplicates):
#   NOTIFY_CONTACT=email>telegram   contact-form messages: email, Telegram only if email fails
#   NOTIFY_CONVERSATION=telegram    live visitor chat feed
#   NOTIFY_DIGEST=telegram          weekly digest
#   NOTIFY_ALERT=telegram>email     health alerts: email only if Telegram fails
# Syntax: "," = both at once, ">" = fall back only if the first failed, e.g. NOTIFY_CONTACT=email,telegram
RATE_LIMIT_CONTACT_PER_HOUR=5

# --- Resume-grounding guard ---
# Every sentence is checked before it is shown or spoken: each number, company and technology
# must appear in the allowed documents, or the sentence is replaced by "I don't have that detail
# in Akash's resume." Modes: block (default), flag (only report), off.
GROUNDING_MODE=block
# Allowed documents: "resume,knowledge" (resume plus Chikki's own write-ups in backend/knowledge)
# or "resume" only, which is the strictest.
GROUNDING_SOURCES=resume,knowledge

# --- Voice ---
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+2%
TTS_PITCH=+1Hz

# --- Security ---
# Comma separated list of frontend origins allowed to call this backend
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
# Required for the feedback dashboard and /resume/sync. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Optional per-IP limits (requests per minute) and caps
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_TTS_PER_MIN=30
RATE_LIMIT_RESUME_PER_MIN=6
RATE_LIMIT_FEEDBACK_PER_MIN=20
MAX_MESSAGE_CHARS=1000
MAX_WS_CONNECTIONS_PER_IP=3

# --- Storage ---
# SQLite feedback database. On Render, point this at a persistent disk mount.
FEEDBACK_DB_PATH=data/feedback.db

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO
