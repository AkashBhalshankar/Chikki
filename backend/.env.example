# Rename this file to .env and fill in your real values. Never commit .env.

# --- LLM providers (tried in this order; configure at least one) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# --- Resume source ---
GOOGLE_DRIVE_RESUME_URL=

# --- Knowledge base (RAG) ---
# Markdown files in backend/knowledge/ are indexed automatically.
# Optional extra sources: comma-separated raw text/Markdown URLs (implemented projects only).
KNOWLEDGE_URLS=
# Optional NVIDIA embedding model for hybrid retrieval (keyword search is used without it).
# Pick a currently available embedding model from build.nvidia.com.
NVIDIA_EMBED_MODEL=
RAG_TOP_K=3

# --- Recruiter-facing extras ---
# Your GitHub username: lets Chikki mention your latest public repos when asked.
GITHUB_USERNAME=

# --- Contact messages ---
# Optional notifications for "Leave a message" submissions (Telegram and/or webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONTACT_WEBHOOK_URL=
RATE_LIMIT_CONTACT_PER_HOUR=5

# --- Voice ---
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+2%
TTS_PITCH=+1Hz

# --- Security ---
# Comma separated list of frontend origins allowed to call this backend
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
# Required for the feedback dashboard and /resume/sync. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Optional per-IP limits (requests per minute) and caps
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_TTS_PER_MIN=30
RATE_LIMIT_RESUME_PER_MIN=6
RATE_LIMIT_FEEDBACK_PER_MIN=20
MAX_MESSAGE_CHARS=1000
MAX_WS_CONNECTIONS_PER_IP=3

# --- Storage ---
# SQLite feedback database. On Render, point this at a persistent disk mount.
FEEDBACK_DB_PATH=data/feedback.db

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO
