# Rename this file to .env and fill in your real values
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Female conversational voice. Other options include en-US-JennyNeural.
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+2%
TTS_PITCH=+1Hz
# Add additional fallback models as NVIDIA_MODEL2, NVIDIA_MODEL3, etc.
# Or use one comma-separated list: NVIDIA_MODELS=model-a,model-b,model-c
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Comma separated list of frontend origins allowed to call this backend
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
