# Rename to .env and point at your backend
VITE_API_URL=http://localhost:8000
# Optional recruiter actions. Leave blank until real links are available.
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# Optional profile card on the start screen. Defaults: name "Akash Bhalshankar", title "AI Engineer".
VITE_PROFILE_NAME=
VITE_PROFILE_TITLE=
# Link to a photo (for example in frontend/public/); initials are shown when empty.
VITE_PROFILE_PHOTO_URL=
# Badge text, e.g. "Open to AI Engineer roles" (default). Set to "off" to hide it.
VITE_OPEN_TO_WORK=
# Optional Cal.com / Calendly link for the "Book a call" button
VITE_BOOKING_URL=
VITE_RESUME_URL=http://localhost:8000/resume
